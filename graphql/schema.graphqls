scalar Time

type User {
  id: ID!
  fullName: String!
  email: String!
  phone: String
  roleId: ID
  createdAt: Time!
  updatedAt: Time!
}

type Category {
  id: ID!
  categoryName: String!
  description: String
}

type Query {
  user(id: ID!): User
  category(id: ID!): Category
  categories: [Category!]!
}

type Mutation {
  createUser(fullName: String!, email: String!, password: String!, phone: String): User!
  createCategory(categoryName: String!, description: String): Category!
}
