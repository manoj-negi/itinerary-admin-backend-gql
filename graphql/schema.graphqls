scalar Time
scalar UUID

type Query

type Mutation {
  login(email: String!, password: String!): LoginResponse!
  }

type LoginResponse {
  token: String!
  user: User!
}
type UploadURL {
  uploadUrl: String!
  publicUrl: String!
}

extend type Mutation {
  getUploadUrl(
    folder: String!,
    fileName: String!,
    contentType: String!
  ): UploadURL!
}