type State {
  id: UUID!
  countryId: UUID!
  name: String!
}

extend type Query {
  state(id: UUID!): State
  states: [State!]!
  statesByCountry(countryId: UUID!): [State!]!
}

extend type Mutation {
  createState(countryId: UUID!, name: String!): State!
  updateState(id: UUID!, countryId: UUID, name: String): State!
  deleteState(id: UUID!): State!
}