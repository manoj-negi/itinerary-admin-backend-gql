type City {
  id: UUID!
  stateId: UUID!
  name: String!
}

extend type Query {
  city(id: UUID!): City
  cities: [City!]!
  citiesByState(stateId: UUID!): [City!]!
}

extend type Mutation {
  createCity(stateId: UUID!, name: String!): City!
  updateCity(id: UUID!, stateId: UUID, name: String): City!
  deleteCity(id: UUID!): City!
}