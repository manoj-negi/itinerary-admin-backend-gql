type User {
  id: UUID!
  full_name: String!
  email: String!
  phone: String
  role_id: UUID
  created_at: Time!
  updated_at: Time!
}

extend type Query {
  user(id: UUID!): User
  users: [User!]!
}

extend type Mutation {
  createUser(full_name: String!, email: String!, password: String!, phone: String): User!
  updateUser(id: UUID!, full_name: String, email: String, password: String, phone: String): User!
  deleteUser(id: UUID!): User!
}
